    },
    {
      "id": "methods_q2",
      "prompt": "What's the difference between a value receiver and a pointer receiver?",
      "choices": [
        {
          "id": "a",
          "text": "A value receiver can mutate the original; a pointer receiver can't"
        },
        {
          "id": "b",
          "text": "A value receiver gets a copy and can't mutate the original; a pointer receiver gets a reference and can"
        },
        {
          "id": "c",
          "text": "They behave identically"
        },
        {
          "id": "d",
          "text": "Pointer receivers are always slower"
        }
      ],
      "correct": "b"
    },
    {
      "id": "methods_q3",
      "prompt": "When should you use a pointer receiver, per this lesson?",
      "choices": [
        {
          "id": "a",
          "text": "Only for small structs"
        },
        {
          "id": "b",
          "text": "When the method needs to modify the receiver's fields, or the struct is large and copying is wasteful"
        },
        {
          "id": "c",
          "text": "Never \u2014 always use value receivers"
        },
        {
          "id": "d",
          "text": "Only for methods that just read data"
        }
      ],
      "correct": "b"
    },
