    {
      "id": "pointers_q3",
      "prompt": "What's the key difference between a function receiving a pointer vs. a plain value?",
      "choices": [
        {
          "id": "a",
          "text": "There is no difference \u2014 both can mutate the original"
        },
        {
          "id": "b",
          "text": "A pointer lets it mutate the caller's variable; a plain value only gets a copy"
        },
        {
          "id": "c",
          "text": "A plain value is always faster to pass"
        },
        {
          "id": "d",
          "text": "Pointers can't be passed to functions"
        }
      ],
      "correct": "b"
    },
    {
      "id": "methods_q1",
